# Docker Environment Variables (Production)
# Copy this file to .env for local Docker deployment

# Database Configuration
POSTGRES_USER=timeblocking
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_DB=timeblocking
DB_PORT=5432

# Application Configuration
APP_PORT=3000

# Database URL (used by Prisma)
DATABASE_URL=postgresql://timeblocking:change_this_password_in_production@db:5432/timeblocking?schema=public
